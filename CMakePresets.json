{
    "version": 10,
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "configurePresets": [
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo (default: with ROS, Python, Tests)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/../workspace/build/superbuild",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "SOURCE_DESTINATION": "${sourceDir}/../workspace/devel",
                "BUILD_DESTINATION": "${sourceDir}/../workspace/build/projects",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/../workspace/install",
		"MC_RTC_SUPERBUILD_VERBOSE": "ON"
            }
        },
        {
            "name": "relwithdebinfo-noros",
            "displayName": "RelWithDebInfo (no ROS)",
            "inherits": [
                "relwithdebinfo"
            ],
            "cacheVariables": {
                "WITH_ROS_SUPPORT": "OFF"
            }
        },
        {
            "name": "relwithdebinfo-nopython",
            "displayName": "RelWithDebInfo (no Python)",
            "inherits": [
                "relwithdebinfo"
            ],
            "cacheVariables": {
                "PYTHON_BINDING": "OFF"
            }
        },
        {
            "name": "relwithdebinfo-noros-nopython",
            "displayName": "RelWithDebInfo (no Python, no ROS)",
            "inherits": [
                "relwithdebinfo"
            ],
            "cacheVariables": {
                "PYTHON_BINDING": "OFF",
                "WITH_ROS_SUPPORT": "OFF"
            }
        },
        {
            "name": "relwithdebinfo-notests",
            "displayName": "RelWithDebInfo (no Tests)",
            "inherits": [
                "relwithdebinfo"
            ],
            "cacheVariables": {
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "hrp5p",
            "displayName": "HRP5P deployment stack (bastien-muraccioli forks, no ROS, no Python, no tests)",
            "description": "mc_rtc, Tasks, tvm, state-observation and mc_state_observation from the forks used by hrp5p_rl_qp_controller (bastien-muraccioli/mc-rtc-superbuild branch hrp5p). Sources go next to this checkout, build and install go to $HOME/workspace-hrp5p so they never mix with another workspace.",
            "inherits": [
                "relwithdebinfo-noros-nopython"
            ],
            "binaryDir": "$env{HOME}/workspace-hrp5p/build/superbuild",
            "cacheVariables": {
                "SOURCE_DESTINATION": "${sourceDir}/../hrp5p-workspace/devel",
                "BUILD_DESTINATION": "$env{HOME}/workspace-hrp5p/build/projects",
                "CMAKE_INSTALL_PREFIX": "$env{HOME}/workspace-hrp5p/install",
                "BUILD_TESTING": "OFF",
                "BUILD_PARALLEL_JOBS": "8",
                "WITH_HRP5": "ON",
                "MC_RTC_SUPERBUILD_OVERRIDE_mc_rtc_GITHUB": "bastien-muraccioli/mc_rtc",
                "MC_RTC_SUPERBUILD_OVERRIDE_mc_rtc_GIT_TAG": "origin/hrp5p",
                "MC_RTC_SUPERBUILD_OVERRIDE_Tasks_GITHUB": "bastien-muraccioli/Tasks",
                "MC_RTC_SUPERBUILD_OVERRIDE_Tasks_GIT_TAG": "origin/master",
                "MC_RTC_SUPERBUILD_OVERRIDE_tvm_GITHUB": "bastien-muraccioli/tvm",
                "MC_RTC_SUPERBUILD_OVERRIDE_tvm_GIT_TAG": "origin/master",
                "MC_RTC_SUPERBUILD_OVERRIDE_state-observation_GITHUB": "bastien-muraccioli/state-observation",
                "MC_RTC_SUPERBUILD_OVERRIDE_state-observation_GIT_TAG": "origin/master",
                "MC_RTC_SUPERBUILD_OVERRIDE_mc_state_observation_GITHUB": "bastien-muraccioli/mc_state_observation",
                "MC_RTC_SUPERBUILD_OVERRIDE_mc_state_observation_GIT_TAG": "origin/main"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "configurePreset": "relwithdebinfo",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        },
        {
            "name": "relwithdebinfo-noros",
            "displayName": "RelWithDebInfo",
            "configurePreset": "relwithdebinfo-noros",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        },
        {
            "name": "relwithdebinfo-nopython",
            "displayName": "RelWithDebInfo",
            "configurePreset": "relwithdebinfo-nopython",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        },
        {
            "name": "relwithdebinfo-noros-nopython",
            "displayName": "RelWithDebInfo",
            "configurePreset": "relwithdebinfo-noros-nopython",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        },
        {
            "name": "relwithdebinfo-notests",
            "displayName": "RelWithDebInfo (no tests)",
            "configurePreset": "relwithdebinfo-notests",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        },
        {
            "name": "hrp5p",
            "displayName": "HRP5P deployment stack",
            "configurePreset": "hrp5p",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        }
    ]
}
