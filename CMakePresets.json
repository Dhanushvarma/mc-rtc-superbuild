{
    "version": 10,
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "configurePresets": [
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo (default: with ROS, Python, Tests)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/../workspace/build/superbuild",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "SOURCE_DESTINATION": "${sourceDir}/../workspace/devel",
                "BUILD_DESTINATION": "${sourceDir}/../workspace/build/projects",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/../workspace/install",
		"MC_RTC_SUPERBUILD_VERBOSE": "ON"
            }
        },
        {
            "name": "relwithdebinfo-noros",
            "displayName": "RelWithDebInfo (no ROS)",
            "inherits": [
                "relwithdebinfo"
            ],
            "cacheVariables": {
                "WITH_ROS_SUPPORT": "OFF"
            }
        },
        {
            "name": "relwithdebinfo-nopython",
            "displayName": "RelWithDebInfo (no Python)",
            "inherits": [
                "relwithdebinfo"
            ],
            "cacheVariables": {
                "PYTHON_BINDING": "OFF"
            }
        },
        {
            "name": "relwithdebinfo-noros-nopython",
            "displayName": "RelWithDebInfo (no Python, no ROS)",
            "inherits": [
                "relwithdebinfo"
            ],
            "cacheVariables": {
                "PYTHON_BINDING": "OFF",
                "WITH_ROS_SUPPORT": "OFF"
            }
        },
        {
            "name": "relwithdebinfo-notests",
            "displayName": "RelWithDebInfo (no Tests)",
            "inherits": [
                "relwithdebinfo"
            ],
            "cacheVariables": {
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "tof",
            "displayName": "ToF sensor work (upstream mc_rtc, no ROS, no Python, no tests)",
            "description": "Sources go next to this checkout, build and install go to $HOME/workspace-tof so they never mix with another workspace.",
            "inherits": [
                "relwithdebinfo-noros-nopython"
            ],
            "binaryDir": "$env{HOME}/workspace-tof/build/superbuild",
            "cacheVariables": {
                "SOURCE_DESTINATION": "${sourceDir}/../tof-workspace/devel",
                "BUILD_DESTINATION": "$env{HOME}/workspace-tof/build/projects",
                "CMAKE_INSTALL_PREFIX": "$env{HOME}/workspace-tof/install",
                "BUILD_TESTING": "OFF",
                "BUILD_PARALLEL_JOBS": "8"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "configurePreset": "relwithdebinfo",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        },
        {
            "name": "relwithdebinfo-noros",
            "displayName": "RelWithDebInfo",
            "configurePreset": "relwithdebinfo-noros",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        },
        {
            "name": "relwithdebinfo-nopython",
            "displayName": "RelWithDebInfo",
            "configurePreset": "relwithdebinfo-nopython",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        },
        {
            "name": "relwithdebinfo-noros-nopython",
            "displayName": "RelWithDebInfo",
            "configurePreset": "relwithdebinfo-noros-nopython",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        },
        {
            "name": "relwithdebinfo-notests",
            "displayName": "RelWithDebInfo (no tests)",
            "configurePreset": "relwithdebinfo-notests",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        },
        {
            "name": "tof",
            "displayName": "ToF sensor work",
            "configurePreset": "tof",
            "configuration": "RelWithDebInfo",
            "targets": [
                "install"
            ]
        }
    ]
}
